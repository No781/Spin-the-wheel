# systemd unit template for Spin the Wheel. deploy/install.sh fills in the @PLACEHOLDERS@ and installs it as
# /etc/systemd/system/spin-the-wheel.service. You normally don't copy this file by hand.
[Unit]
Description=Spin the Wheel (site + realtime rooms)
After=network.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@/server
ExecStart=@NODE_BIN@ server.js
Restart=always
RestartSec=2

# Listen only on localhost; the web server (nginx) proxies public traffic to it.
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=@PORT@
# We sit behind a reverse proxy that overwrites X-Forwarded-For, so use it for per-IP limits.
Environment=TRUST_PROXY=1
# systemd creates /var/lib/spin-the-wheel owned by the service user. Rooms are saved here.
StateDirectory=spin-the-wheel
Environment=DATA_FILE=/var/lib/spin-the-wheel/rooms.json

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=300M

[Install]
WantedBy=multi-user.target
