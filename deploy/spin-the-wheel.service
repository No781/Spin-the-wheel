# systemd unit for the Spin the Wheel server.
# Install:  sudo cp spin-the-wheel.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now spin-the-wheel
[Unit]
Description=Spin the Wheel (site + realtime rooms)
After=network.target

[Service]
Type=simple
User=wheel
Group=wheel
WorkingDirectory=/opt/spin-the-wheel/app/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2

# Listen only on localhost; Caddy terminates HTTPS and proxies to us.
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
# We sit behind a reverse proxy, so take the client IP from X-Forwarded-For (used for per-IP limits).
Environment=TRUST_PROXY=1
# systemd creates /var/lib/spin-the-wheel owned by the service user. Rooms are saved here.
StateDirectory=spin-the-wheel
Environment=DATA_FILE=/var/lib/spin-the-wheel/rooms.json

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=300M

[Install]
WantedBy=multi-user.target
